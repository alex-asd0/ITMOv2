{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  },
  "mcp": {
    "lab-tester": {
      "type": "stdio",
      "command": [
        "python3",
        "tools/lab_mcp_server.py"
      ],
      "enabled": true
    }
  },
  "rules": [
    { "path": "AGENTS.md" }
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "plugin": [
    "file:///home/alex/code/vibecode/.opencode/plugins/auto-tests.js"
  ]
}
